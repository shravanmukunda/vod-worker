TOURNEY_API_BASE=http://localhost:8082/api/v1
VOD_WORKER_TOKEN=change-me
POLL_SECONDS=20
WORK_DIR=./work
PADDING_BEFORE_SEC=
PADDING_AFTER_SEC=
SKIP_R2_UPLOAD=false
SKIP_YOUTUBE_UPLOAD=false
YOUTUBE_CLIENT_SECRETS=./client_secret.json
YOUTUBE_TOKEN_FILE=./youtube_token.json
YOUTUBE_PRIVACY=private
YOUTUBE_CATEGORY_ID=17

# Optional: production Postgres for youtube_backfill.py when the upload-queue API
# is not deployed yet (postgresql://user:pass@host:5432/dbname).
DATABASE_URL=
YTDLP_BIN=yt-dlp
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_COOKIES_FILE=
YTDLP_REMOTE_COMPONENTS=
FFMPEG_BIN=ffmpeg
PUBLIC_APP_URL=http://localhost:3000

R2_ENABLED=false
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_REGION=auto
